#usda 1.0
(
    customLayerData = {
        string creator = "Reality Composer Pro Version 2.0 (494.8.1)"
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

reorder rootPrims = ["Root", "SpatialAudio"]

def Xform "Root"
{
    reorder nameChildren = ["Sphere", "FireBallMaterial", "UpLight", "DownLight", "Fire", "fireSound", "FireSpatialAudio"]
    def Sphere "Sphere" (
        active = true
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        reorder nameChildren = ["DefaultMaterial", "SpatialAudio", "FireSpatialAudio"]
        rel material:binding = </Root/FireBallMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        double radius = 0.1
        quatf xformOp:orient = (1, 0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def Material "DefaultMaterial"
        {
            token outputs:mtlx:surface.connect = </Root/Sphere/DefaultMaterial/PreviewSurface.outputs:out>
            token outputs:realitykit:vertex
            token outputs:surface.connect = </Root/Sphere/DefaultMaterial/DefaultSurfaceShader.outputs:surface>
            float2 ui:nodegraph:realitykit:subgraphOutputs:pos = (0, 110.5)

            def Shader "DefaultSurfaceShader" (
                active = true
            )
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:roughness = 0.75
                token outputs:surface
            }

            def Shader "PreviewSurface" (
                active = false
            )
            {
                uniform token info:id = "ND_UsdPreviewSurface_surfaceshader"
                token outputs:out
                float2 ui:nodegraph:node:pos = (-255, 105)
            }
        }

        def RealityKitComponent "SpatialAudio"
        {
            float directivityFocus = -4.8572917
            float directLevel = -4.8572917
            float gain = -5.009375
            uniform token info:id = "RealityKit.SpatialAudio"
            float rolloffFactor = -5.009375
        }

        def Xform "FireSpatialAudio" (
            prepend apiSchemas = ["MaterialBindingAPI"]
            customData = {
                float3 rotationEulerHint = (6.283184, 6.2831845, 6.283185)
            }
        )
        {
            reorder nameChildren = ["SpatialAudio", "fireSound"]
            rel material:binding = </Root/FireBallMaterial> (
                bindMaterialAs = "weakerThanDescendants"
            )
            quatf xformOp:orient = (1, -3.8941437e-7, -1.5099585e-7, 8.742272e-8)
            float3 xformOp:scale = (1, 1, 1)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            def RealityKitComponent "SpatialAudio"
            {
                float directivityFocus = 0.012274305
                float directLevel = 0
                float gain = 0
                uniform token info:id = "RealityKit.SpatialAudio"
                float reverbLevel = -9.865625
                float rolloffFactor = 5
            }

            def RealityKitAudioFile "fireSound"
            {
                uniform token calibrationMode = "relative"
                uniform asset file = @fire.mp3@
                uniform token loadingStrategy = "Stream"
                uniform bool shouldLoop = 1
                uniform bool shouldRandomizeStartTime = 0
            }
        }
    }

    def Material "FireBallMaterial"
    {
        token outputs:mtlx:surface
        token outputs:realitykit:vertex
        token outputs:surface.connect = </Root/FireBallMaterial/UsdPreviewSurface.outputs:surface>

        def Shader "UsdPreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.59707034, 0.23058249, 0.12861337) (
                colorSpace = "srgb_displayp3"
            )
            token outputs:surface
        }
    }

    def Xform "UpLight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/FireBallMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float3 xformOp:translate = (-0.04815016, 0.9005189, 0.039262056)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "PointLight"
        {
            float attenuationFalloffExponent = 12
            float3 color = (1, 0.31897038, 0)
            token info:id = "RealityKit.PointLight"
            float intensity = 26963.76
        }

        def RealityKitComponent "AnimationLibrary"
        {
            uniform token info:id = "RealityKit.AnimationLibrary"
        }
    }

    def Xform "DownLight" (
        prepend apiSchemas = ["MaterialBindingAPI"]
        customData = {
            float3 rotationEulerHint = (-3.874556e-9, 0.22415654, -3.442522e-8)
        }
    )
    {
        rel material:binding = </Root/FireBallMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float2 ui:nodegraph:node:pos = (20, 20)
        int ui:nodegraph:node:stackingOrder = 1
        quatf xformOp:orient = (0.99372584, 0, 0.11184377, -1.6887942e-8)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (-0.07193495, -0.9239193, 0.021936893)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        def RealityKitComponent "PointLight"
        {
            float attenuationFalloffExponent = 12
            float3 color = (1, 0.31897038, 0)
            token info:id = "RealityKit.PointLight"
            float intensity = 26963.76
        }

        def RealityKitComponent "AnimationLibrary"
        {
            uniform token info:id = "RealityKit.AnimationLibrary"
        }
    }

    def Xform "Fire"
    {
        def RealityKitComponent "VFXEmitter"
        {
            token info:id = "RealityKit.VFXEmitter"

            def RealityKitStruct "currentState"
            {
                token birthDirection = "Local"
                token birthLocation = "Volume"
                double emissionDuration = 0
                token emitterShape = "Plane"
                bool isLocal = 1
                bool isLocalFields = 0
                float particleSpeed = 1

                def RealityKitStruct "mainEmitter"
                {
                    float4 endColorA = (1, 0.008742433, 0, 1)
                    double particleLifeSpan = 1
                    float particleSize = 0.04
                    float sizeMultiplierAtEndOfLifespan = 0
                    bool useEndColor = 1
                    bool useEndColorRange = 0
                }

                def RealityKitStruct "spawnedEmitter"
                {
                }
            }
        }
    }
}

